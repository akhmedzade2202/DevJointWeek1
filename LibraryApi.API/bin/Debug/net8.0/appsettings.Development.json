{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=LibraryDevDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "SuperSecretKeyForJwtTokenGeneration_ChangeThisInProduction_MinLength32Chars",
    "Issuer": "LibraryApi",
    "Audience": "LibraryApiUsers",
    "ExpiryMinutes": 120
  },
  "Cache": {
    "AbsoluteExpirationMinutes": 5,
    "SlidingExpirationMinutes": 2
  },
  "FileStorage": {
    "UploadPath": "uploads",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [
      ".pdf",
      ".jpg",
      ".jpeg",
      ".png",
      ".txt"
    ]
  },
  "LoanCleanup": {
    "OverdueDaysThreshold": 30
  },
  "Email": {
    "SimulatedDelayMs": 50
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "LibraryApi": "Debug"
    }
  }
}