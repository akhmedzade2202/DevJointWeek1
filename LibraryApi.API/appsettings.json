{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=LibraryDevDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Key": "SuperSecretKeyForJwtTokenGeneration_ChangeThisInProduction_MinLength32Chars",
    "Issuer": "LibraryApi",
    "Audience": "LibraryApiUsers",
    "ExpiryMinutes": 60
  },
  "Cache": {
    "AbsoluteExpirationMinutes": 10,
    "SlidingExpirationMinutes": 5
  },
  "FileStorage": {
    "UploadPath": "uploads",
    "MaxFileSizeBytes": 5242880,
    "AllowedExtensions": [
      ".pdf",
      ".jpg",
      ".jpeg",
      ".png"
    ]
  },
  "LoanCleanup": {
    "OverdueDaysThreshold": 30
  },
  "Email": {
    "SimulatedDelayMs": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}